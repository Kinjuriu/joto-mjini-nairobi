# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Large data (rebuild with the pipeline)
data/raw/
data/interim/
data/_trash/
_trash/

# Node
site/node_modules/
site/dist/

# OS and editors
.DS_Store
.vscode/

# Logs can be large; keep the folder, not the files
logs/*.log
data/processed/nairobi_buildings.parquet
data/processed/kisumu/kisumu_buildings.parquet

# Local secrets (Mapbox token lives in site/.env.local)
*.local

# macOS FUSE leftovers
.fuse_hidden*

# Sentinel-2 composites (over or near 50 MB; rebuild with src/pipeline/s8_sentinel2.py)
data/processed/rasters/s2_*.tif

# Walkthrough video (64 MB, over the 50 MB limit); rebuild with site/qa/v2_full.mjs video
outputs/demo/*.webm
outputs/demo/_raw/
