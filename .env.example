# Copy this file to .env and fill in only what you have. Everything is optional;
# the overnight run works without any of these, using sources that need no login.
# Never commit .env.

# Copernicus Data Space Ecosystem (Sentinel Hub OAuth client), for the optional
# CLMS hourly surface temperature step. Create at https://shapps.dataspace.copernicus.eu/dashboard/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# NASA Earthdata login, only needed for the HLS fallback. https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
